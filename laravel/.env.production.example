# ---------------------------------------------------------------------------
# FormBuilder - PRODUCTION environment template
#
# Copy this to `.env` on the server, then fill in the values marked CHANGE ME.
#
#   copy .env.production.example .env
#   php artisan key:generate
#
# DO NOT copy .env.example for production - it ships APP_DEBUG=true, which
# renders stack traces and credentials into the browser on any error.
#
# NEVER commit the real .env. It is gitignored on purpose.
# ---------------------------------------------------------------------------

APP_NAME='Form Builder'
APP_ENV=production
# Leave APP_KEY blank; `php artisan key:generate` fills it in.
# Without an APP_KEY, EVERY request returns HTTP 500.
APP_KEY=
# APP_DEBUG MUST stay false in production. true leaks stack traces,
# file paths, DB credentials and mail passwords to anyone who triggers an error.
APP_DEBUG=false
# CHANGE ME - the real URL users will visit. Use https:// once TLS is set up.
APP_URL=https://formbuilder.emb.gov.ph

APP_LOCALE=en
APP_TIMEZONE=Asia/Singapore
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 'debug' is noisy and can log sensitive context. Use warning in production.
LOG_LEVEL=warning

# --- Database -------------------------------------------------------------
# This points at the EXISTING live database. Back it up before deploying.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=form_builder
# CHANGE ME - do not run the app as root in production if you can avoid it.
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=+08:00

TRUSTED_PROXIES=127.0.0.1,::1

# --- Session --------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Only send the session cookie over HTTPS. Set to false ONLY if the site is
# still plain HTTP - but then sessions can be stolen on the network.
SESSION_SECURE_COOKIE=true
# Blocks JavaScript from reading the session cookie (XSS defence).
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# --- Mail (Microsoft 365 SMTP) --------------------------------------------
# Used for the super-admin password-reset code emails.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
# CHANGE ME - the sending mailbox and its password.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Test guards ----------------------------------------------------------
# The E2E test endpoints (test_reset_database.php etc.) are disabled unless
# APP_ENV=testing. Leave this UNSET in production. Never set it to 1 here.
# FB_ALLOW_TEST_GUARD=
